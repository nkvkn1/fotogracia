# Contact form email delivery (Resend — https://resend.com)
# Copy this file to .env.local and fill in real values. .env.local is git-ignored.

# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Sender address. The domain must be verified in Resend.
# For local testing before domain verification, use: onboarding@resend.dev
CONTACT_FROM_EMAIL=Fotogracia <enquiries@fotogracia.com>

# Where enquiries are delivered. Defaults to info@fotogracia.com if unset.
CONTACT_TO_EMAIL=info@fotogracia.com
